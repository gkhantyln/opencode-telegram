# ============================================
# opencode-telegram — ornek env
# ============================================
# Kopyala: copy .env.example .env (paket kokunde)
# Bridge .env'yi once TELEGRAM_PROJECT_DIR'den, yoksa paket kokunden okur.

# Hedef proje dizini (bos = otomatik: ic ice kullanimda repo koku, pakette paket dizini)
# TELEGRAM_PROJECT_DIR=C:\path\to\project

# --- Telegram koprusu (zorunlu) ---
# Bot token: BotFather ile alin.
TELEGRAM_BOT_TOKEN=
# Izinli chat ID'leri (virgullu). Ornek: 123456789
TELEGRAM_ALLOWED_CHAT_IDS=
# Varsayilan hedef (telegram_send "to" bosken). Genelde kendi chat id'niz.
TELEGRAM_DEFAULT_CHAT_ID=

# --- Opsiyonel ---
# Calisan ajan (varsayilan orchestrator)
# TELEGRAM_OPENCODE_AGENT=orchestrator
# Model (bos = opencode varsayilani). Ornek: opencode/muse-spark-1.3-contributor-free
# TELEGRAM_OPENCODE_MODEL=
# Backend: cli (varsayilan, opencode run) | serve (sicak oturum + streaming + butonlar)
# TELEGRAM_BACKEND=cli
# Serve ayari (backend=serve iken; password bossa uretilir, serve otomatik acilir)
# TELEGRAM_SERVE_URL=http://127.0.0.1:4096
# TELEGRAM_SERVE_PORT=4096
# TELEGRAM_SERVE_PASSWORD=
# Oturum one-eki (basliklarda kullanilir)
# TELEGRAM_SESSION_PREFIX=tg
# Sadece kuyruk modu: 0 (TUI orchestrator islesin, bridge calistirmasin)
# TELEGRAM_BRIDGE_EXEC=1
# Tek calistirma zaman asimi (sn)
# TELEGRAM_OPENCODE_TIMEOUT=600
# Long-poll suresi (sn, max 50)
# TELEGRAM_POLL_TIMEOUT=30
# Gunluk token limiti (0 = kapali). Asilinca yeni isler durur.
# TELEGRAM_DAILY_TOKEN_LIMIT=0
# Zamanlayici: "HH:MM:/komut;..." (varsayilan chat'e)
# TELEGRAM_SCHEDULE=
# Cok proje: "alias=yol,alias2=yol2" + Telegram'dan /project set
# TELEGRAM_PROJECTS=
# Saatlik bildirim ozeti: 1
# TELEGRAM_DIGEST=0
